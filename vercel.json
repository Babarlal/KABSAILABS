{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kabsailabs.com"
        }
      ],
      "destination": "https://www.kabsailabs.com/:path*",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/automatic-business-reporting-2026",
      "destination": "/blog/automated-client-reporting",
      "statusCode": 301
    },
    {
      "source": "/blog/document-data-extraction-ai-2026",
      "destination": "/blog/ai-document-data-extraction",
      "statusCode": 301
    },
    {
      "source": "/blog/returns-refunds-automation-2026",
      "destination": "/blog/returns-automation",
      "statusCode": 301
    },
    {
      "source": "/blog/ecommerce-order-shipping-automation",
      "destination": "/blog/where-is-my-order-automation",
      "statusCode": 301
    },
    {
      "source": "/blog/automatic-lead-follow-up-2026",
      "destination": "/blog/lead-follow-up",
      "statusCode": 301
    },
    {
      "source": "/blog/website-chat-agent-2026",
      "destination": "/blog/ai-website-chat",
      "statusCode": 301
    },
    {
      "source": "/blog/whatsapp-ai-support-2026",
      "destination": "/blog/whatsapp-sms-customer-support",
      "statusCode": 301
    },
    {
      "source": "/blog/automatic-appointment-booking-2026",
      "destination": "/blog/automatic-appointment-booking",
      "statusCode": 301
    },
    {
      "source": "/blog/instant-lead-response-ai-2026",
      "destination": "/blog/speed-to-lead",
      "statusCode": 301
    },
    {
      "source": "/blog/missed-call-text-back-2026",
      "destination": "/blog/missed-call-text-back",
      "statusCode": 301
    },
    {
      "source": "/blog/getting-started-with-ai-in-2026",
      "destination": "/blog/ai-automation-for-small-business-questions",
      "statusCode": 301
    },
    {
      "source": "/blog/ai-content-writing-small-business-2026",
      "destination": "/blog/ai-automation-for-small-business-questions",
      "statusCode": 301
    },
    {
      "source": "/blog/repurpose-content-automation",
      "destination": "/blog/ai-automation-for-small-business-questions",
      "statusCode": 301
    },
    {
      "source": "/blog/automated-outbound-sales-2026",
      "destination": "/blog/ai-automation-for-small-business-questions",
      "statusCode": 301
    },
    {
      "source": "/blog/company-market-research-automation",
      "destination": "/blog/ai-automation-for-small-business-questions",
      "statusCode": 301
    },
    {
      "source": "/blog/meeting-notes-action-items-automation",
      "destination": "/blog/ai-automation-for-small-business-questions",
      "statusCode": 301
    },
    {
      "source": "/blog/business-monitoring-alerts-ai",
      "destination": "/services/workflow-automation",
      "statusCode": 301
    },
    {
      "source": "/blog/connect-business-systems-automation",
      "destination": "/services/workflow-automation",
      "statusCode": 301
    },
    {
      "source": "/blog/win-back-lost-customers-ai",
      "destination": "/services/ai-automation",
      "statusCode": 301
    },
    {
      "source": "/blog/automatic-review-requests-2026",
      "destination": "/services/ai-automation",
      "statusCode": 301
    },
    {
      "source": "/services/voice-ai",
      "destination": "/services/ai-for-trades",
      "permanent": true
    },
    {
      "source": "/services/ai-legal-medical-docs",
      "destination": "/services/ai-automation",
      "permanent": true
    },
    {
      "source": "/services/analytics",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/analytics/:path*",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/gohighlevel-automation",
      "destination": "/services/workflow-automation",
      "permanent": true
    },
    {
      "source": "/case-studies/:slug+",
      "destination": "/case-studies",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdnjs.cloudflare.com https://assets.calendly.com https://esm.sh https://va.vercel-scripts.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://www.googletagmanager.com https://assets.calendly.com https://*.calendly.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://www.google.ca https://cdn.simpleicons.org; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://calendly.com https://*.calendly.com https://script.google.com https://script.googleusercontent.com https://*.retellai.com wss://*.retellai.com https://*.livekit.cloud wss://*.livekit.cloud https://esm.sh https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com https://www.google.ca https://pagead2.googlesyndication.com; worker-src 'self' blob:; media-src 'self' blob:; frame-src https://calendly.com https://*.calendly.com https://www.googletagmanager.com https://td.doubleclick.net https://bid.g.doubleclick.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
